  "item": [
    {
      "name": "01 - Estado del servicio",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Usuario único por ejecución para poder repetir las pruebas",
              "pm.collectionVariables.set('usuario', 'jose_' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código de estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Estado activo', () => { pm.expect(pm.response.json().estado).to.eql('activo'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": []
        }
      }
    },
